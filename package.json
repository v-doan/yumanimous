{
  "name": "yumanimous",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w @yumanimous/api\" \"npm run dev -w @yumanimous/web\"",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @yumanimous/db",
    "mcp:smoke": "tsx scripts/mcpSmoke.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:roles": "npm run -s db:roles -w @yumanimous/db",
    "setup:prod": "tsx scripts/setupProduction.ts",
    "eval": "npm run eval -w @yumanimous/api --"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
