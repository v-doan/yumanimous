{
  "name": "@yumanimous/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "deck:bench": "tsx --env-file-if-exists=../../.env scripts/deckBench.ts",
    "agent:smoke": "tsx --env-file-if-exists=../../.env scripts/agentSmoke.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "tsx --env-file-if-exists=../../.env evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@yumanimous/db": "^0.0.0",
    "@yumanimous/mcp-recipes": "^0.0.0",
    "@yumanimous/mcp-session": "^0.0.0",
    "@yumanimous/shared": "*",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "tsx": "4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
