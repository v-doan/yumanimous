# Copy to apps/api/.env (gitignored). Everything is optional in development:
# without DATABASE_URL sessions live in memory; without a recipe key the deck is
# the hard-coded recipes.

# Port the API listens on. The web dev server proxies /api and /socket.io here.
PORT=3001

# Postgres. `npm run db:up` starts one in Docker with these dev-only credentials.
DATABASE_URL=postgres://yumanimous:yumanimous@localhost:5432/yumanimous

# Recipe API key from https://spoonacular.com/food-api (free tier: 50 points/day).
# Recipes are fetched as a cached pool, so normal use stays well inside that.
SPOONACULAR_API_KEY=

# Production only: the web app's origin, when it is served from a different host
# than the API. Enables CORS and Socket.io for exactly this origin.
# WEB_ORIGIN=https://yumanimous.example.com

# Web build (apps/web): the API origin in production. Leave unset in development.
# VITE_API_URL=https://api.yumanimous.example.com

# Tests: use an existing Postgres instead of starting one with Testcontainers.
# TEST_DATABASE_URL=postgres://yumanimous:yumanimous@localhost:5432/postgres
